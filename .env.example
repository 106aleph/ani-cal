# ===== 公開ポート =====
# ホストの 127.0.0.1:<APP_PORT> で待ち受け、ホストの tailscale serve から転送する
APP_PORT=8000

# ===== 取得設定（省略可・既定値） =====
# 定期取得の間隔（時間）。0 で自動取得しない
#SYNC_INTERVAL_HOURS=6
# 初回取得で遡る日数 / 先の日数（2回目以降は前回からの更新分だけを差分取得）
#SYNC_DAYS_BACK=60
#SYNC_DAYS_FORWARD=120
# 自動取得が連続でこの回数失敗したら自動取得を停止（0で無効）。手動取得に成功すると再開
#SYNC_MAX_FAILURES=5
# User-Agent に入れる案内ページのURL（連絡方法を載せた公開ページ）。設定してください
SYOBOI_UA_URL=
# しょぼいカレンダーへのリクエスト間隔（秒）。短くしすぎないこと
#SYOBOI_INTERVAL_SEC=1.5
# 429/503 でこれ以上（秒）の待ちを求められたら、待たずに取得を失敗として終える
#SYOBOI_MAX_WAIT_SEC=300
# 取得するチャンネルグループID（カンマ区切り, 空=全部）。地上波を取らず配信だけにしたい場合などに
#SYNC_CHGIDS=
# 再放送(Flag=8)を除外
#SKIP_REBROADCAST=true

# ===== 新作一覧 =====
# 放送開始月が「今月-3ヶ月〜今月+6ヶ月」の作品を新作として表示
#NEW_MONTHS_BACK=3
#NEW_MONTHS_FORWARD=6
# 放送中（今以降の予定がある）の作品は、開始がこの月数前までなら表示（分割2クール・長期放送用）
#NEW_MONTHS_BACK_AIRING=12
# 対象カテゴリ（しょぼいカレンダーのCat。1=アニメ, 7=OVA, 8=映画, 10=アニメ(終了/再放送)）
#NEW_CATS=1
# 「配信系」とみなすチャンネルグループ（ID指定 or グループ名に含まれる語）
#NET_GROUP_IDS=
#NET_GROUP_KEYWORDS=ネット,インターネット,配信,web

# ===== 通知（Web Push） =====
# 通知サービスに渡す連絡先（https:// のURL か mailto:）。空なら SYOBOI_UA_URL を使う
#PUSH_SUBJECT=
